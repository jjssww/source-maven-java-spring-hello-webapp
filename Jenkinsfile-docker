pipeline {
    // 전체 공통 에이전트를 지정하지 않고 각 단계에서 실행 환경을 선택합니다.
    agent none
    // 단계가 서로 다른 노드에서 실행되면 작업 공간과 빌드 결과가 공유되지 않을 수 있습니다.
    stages {
        stage('Checkout') {
            // Maven과 Java 21이 설치된 컨테이너에서 소스 코드를 가져옵니다.
            agent {
                docker { image 'maven:3-eclipse-temurin-21' }
            }
            steps {
                git branch: 'main', url: 'https://github.com/jjssww/source-maven-java-spring-hello-webapp.git' // 실제 Git 저장소 주소로 변경
            }
        }
        stage('Test Application') {
            agent {
                docker { image 'maven:3-eclipse-temurin-21' }
            }
            steps {
                sh 'mvn test' // Maven 테스트 실행
            }
        }
        stage('Build Application') {
            agent {
                docker { image 'maven:3-eclipse-temurin-21' }
            }
            steps {
                // 이전 빌드 결과를 지우고 패키지를 생성합니다. 테스트는 앞 단계에서 수행합니다.
                sh 'mvn clean package -DskipTests=true'
            }
        }
        stage('Build Container Image') {
            // controller 라벨이 붙은 노드에서 Docker 이미지 빌드 명령을 실행합니다.
            agent { label 'controller' }
            steps {
                sh 'docker image build -t testmg .' // 실제 docker build 명령으로 변경. 현재 폴더 파일
            }
        }
        stage('Tag Container Image') {
            agent { label 'controller' }
            steps {
                sh 'docker image tag testimg jjssww/mytomat:v${BUILD_NUMBER}' // 빌드 번호 태그 지정
                sh 'docker image tag testimg jjssww/mytomcat:latest' // latest 태그 지정
            }
        }
        stage('Push Container Image') {
            agent { label 'controller' }
            steps {
                // Jenkins에 저장한 자격 증명으로 Docker Hub에 인증합니다.
                withDockerRegistry(credentialsId: 'docker-registry-credential', url: 'https://index.docker.io/v1/') {
                    sh 'docker image push jjssww/mytomcat:v${BUILD_NUMBER}' // 빌드 번호 태그 이미지 업로드
                    sh 'docker image push jjssww/mytomcat:latest' // latest 태그 이미지 업로드
                }
            }
        }
        stage('Run Container') {
            agent { label 'controller' }
            steps {
                // 이미지를 백그라운드로 실행하고 호스트 80번 포트를 컨테이너 8080번에 연결합니다.
                // 꺾쇠 괄호의 값은 실제 컨테이너 이름, 이미지 이름, 빌드 번호로 변경합니다.
                sh 'docker container run --detach --name mytomcat -p 80:8080 jjssww/mytomcat:latest'
            }
        }
    }
}
